# SmartChunk Environment Configuration
# Copy this file to .env and fill in your values.

# ── LLM Provider ──────────────────────────────────────────────
# Model to use for enrichment (any LiteLLM-supported model string)
# Examples: gpt-4o-mini, claude-3-haiku-20240307, ollama/llama3
SMARTCHUNK_MODEL=gpt-4o-mini

# API keys (set the one(s) matching your chosen model)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Chunking Defaults ─────────────────────────────────────────
# SMARTCHUNK_CHUNK_SIZE=512
# SMARTCHUNK_CHUNK_OVERLAP=50
# SMARTCHUNK_STRATEGY=semantic

# ── Enrichment ────────────────────────────────────────────────
# SMARTCHUNK_ENRICH=true
# SMARTCHUNK_BATCH_SIZE=10
# SMARTCHUNK_MAX_CONCURRENCY=5

# ── Export ────────────────────────────────────────────────────
# PINECONE_API_KEY=pc-...
# PINECONE_ENVIRONMENT=us-east-1
